#!/usr/bin/env bash
# What a release ships (R9), in dist/.
#   scripts/build          this platform's bundle and its signature
#   scripts/build --feed   latest.json, from the signed bundles in dist/
# The bundle is laid out so packaging/install.sh, unpacked as-is, finds
# bin/squiggle and skips the build; the app updates by running it.
set -euo pipefail
cd "$(dirname "$0")/.."
version="$(.toolkit/version)"
releases="https://github.com/Genoux/squiggle/releases/download/v$version"

if [ "${1:-}" = --feed ]; then
  python3 - "$version" "$releases" <<'PY'
import datetime, glob, json, os, sys
version, releases = sys.argv[1:3]
platforms = {}
for signature in sorted(glob.glob(f"dist/squiggle-v{version}-*.tar.gz.sig")):
    bundle = os.path.basename(signature)[: -len(".sig")]
    platform = bundle[len(f"squiggle-v{version}-") : -len(".tar.gz")]
    platforms[platform] = {"url": f"{releases}/{bundle}", "signature": open(signature).read()}
if not platforms:
    sys.exit(f"no signed bundle of {version} in dist/")
feed = {
    "version": version,
    "notes": f"https://github.com/Genoux/squiggle/releases/tag/v{version}",
    "pub_date": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "platforms": platforms,
}
json.dump(feed, open("dist/latest.json", "w"), indent=2)
print("dist/latest.json:", ", ".join(platforms))
PY
  exit 0
fi

# An installed copy refuses a bundle the key did not sign, so one is never
# made without it.
if [ -z "${UPDATER_SIGNING_KEY:-}" ]; then
  echo "UPDATER_SIGNING_KEY is not set: a bundle is never shipped unsigned" >&2
  exit 1
fi

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) platform=darwin-aarch64 ;;
  Darwin-x86_64) platform=darwin-x86_64 ;;
  Linux-x86_64) platform=linux-x86_64 ;;
  Linux-aarch64) platform=linux-aarch64 ;;
  *) echo "no bundle for $(uname -s) on $(uname -m)" >&2; exit 1 ;;
esac

cargo build --release
# Asked rather than assumed, as the installer does: a target-dir in
# ~/.cargo/config.toml moves the binaries out of the checkout.
target="$(cargo metadata --format-version 1 --no-deps | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')"

name="squiggle-v$version-$platform"
rm -rf "dist/$name" && mkdir -p "dist/$name/bin" "dist/$name/assets/brand/generated"
cp "$target/release/squiggle" "dist/$name/bin/"
cp -r packaging "dist/$name/"
cp assets/brand/generated/Squiggle.icns "dist/$name/assets/brand/generated/"
cp README.md TROUBLESHOOTING.md LICENSE "dist/$name/"
tar -czf "dist/$name.tar.gz" -C dist "$name"
rm -rf "dist/$name"
cargo run --quiet --release -p squiggle-core --example sign -- "dist/$name.tar.gz"
echo "dist/$name.tar.gz and its .sig"
